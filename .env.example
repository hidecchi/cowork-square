# ===== Square（必須）=====
# Developer Console → Credentials から Access Token をコピー
SQUARE_ACCESS_TOKEN=

# Developer Console → Locations に表示される ID（ダッシュボード URL の数字ではない）
SQUARE_LOCATION_ID=

# Terminal API 用の device_id（※ Device Code の id ではない）
# List Device Codes で status=PAIRED のときの device_id
# 例: 952CS108A6002588（device:xxxx やコード 6 桁は不可）
SQUARE_DEVICE_ID=

# Access Token の種類と必ず揃える
#   サンドボックストークン → sandbox
#   Production Access Token → production
SQUARE_ENVIRONMENT=sandbox

# （任意）
# SQUARE_API_VERSION=2025-04-16

# ===== IP 制限（任意）=====
# カンマ区切り。設定した IP 以外は 403。未設定なら制限しない
# ローカル確認時は 127.0.0.1,::1 も入れる
# ALLOWED_IPS=203.0.113.10,198.51.100.20

# ===== API 保護（任意）=====
# 設定した場合、クライアントも同じ値を送る必要がある
# API_KEY=
# NEXT_PUBLIC_API_KEY=

# ===== 商品が複数あるときだけ（任意）=====
# NEXT_PUBLIC_CATALOG_ITEM_ID=
# NEXT_PUBLIC_CATALOG_VARIATION_ID=
